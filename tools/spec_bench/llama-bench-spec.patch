+// state for the speculative decoding benchmark mode
+struct spec_state {
+    common_speculative * spec    = nullptr;
+    llama_context *      ctx_dft = nullptr;
+    common_sampler *     smpl    = nullptr;
+    int                  n_max   = 3;
+
+    // whether the contexts can only remove complete sequences (checkpoints + replay are needed)
+    bool use_ckpt_tgt = false;
+    bool use_ckpt_dft = false;
+
+    // tokens that have been evaluated in the target context (i.e. are in its KV cache)
+    llama_tokens prompt_tgt;
+    // the next token to evaluate - it is not in the KV cache yet
+    llama_token id_last = 0;
+    int         n_past  = 0;
+
+    // statistics, accumulated over the timed repetitions
+    int64_t n_draft    = 0; // draft tokens that were verified
+    int64_t n_accepted = 0; // draft tokens that were accepted
+    int64_t n_steps    = 0; // verification steps
+    int64_t n_gen      = 0; // tokens actually produced
+
+    // the generated tokens (only kept for diagnostics)
+    llama_tokens output;
+};
+
+// prime the target and draft contexts before a generation test:
+// evaluate the prompt, sample the first token and feed the prompt to the speculative implementation(s)
+static bool spec_prepare(llama_context * ctx, spec_state & ss, const llama_tokens & prompt,
+                         int n_batch, int n_threads) {
+    llama_set_n_threads(ctx, n_threads, n_threads);
+
+    llama_memory_t mem_tgt = llama_get_memory(ctx);
+    llama_memory_t mem_dft = ss.ctx_dft ? llama_get_memory(ss.ctx_dft) : nullptr;
+
+    llama_memory_clear(mem_tgt, false);
+    if (mem_dft) {
+        llama_memory_clear(mem_dft, false);
+    }
+
+    ss.prompt_tgt.clear();
+    ss.n_past = 0;
+
+    // each repetition is an independent generation - start from the same sampler state
+    // (the server also creates a fresh sampler per request)
+    common_sampler_reset(ss.smpl);
+
+    if (g_spec_debug) {
+        ss.output.clear();
+    }
+
+    // without a prompt, start from BOS
+    llama_tokens inp = prompt;
+    if (inp.empty()) {
+        const llama_vocab * vocab = llama_model_get_vocab(llama_get_model(ctx));
+        inp.push_back(llama_vocab_get_add_bos(vocab) ? llama_vocab_bos(vocab) : 0);
+    }
+
+    llama_batch batch = llama_batch_init(n_batch, 0, 1);
+
+    int n_processed = 0;
+    while (n_processed < (int) inp.size()) {
+        const int n_tokens = std::min((int) inp.size() - n_processed, n_batch);
+
+        common_batch_clear(batch);
+        for (int i = 0; i < n_tokens; i++) {
+            const bool logits = n_processed + i == (int) inp.size() - 1;
+            common_batch_add(batch, inp[n_processed + i], n_processed + i, { 0 }, logits);
+        }
+
+        if (llama_decode(ctx, batch) != 0) {
+            fprintf(stderr, "%s: failed to decode prompt batch\n", __func__);
+            llama_batch_free(batch);
+            return false;
+        }
+
+        if (!common_speculative_process(ss.spec, batch)) {
+            fprintf(stderr, "%s: failed to process speculative prompt batch\n", __func__);
+            llama_batch_free(batch);
+            return false;
+        }
+
+        n_processed += n_tokens;
+    }
+
+    // the logits of the last prompt token predict the first generated token
+    ss.id_last = common_sampler_sample(ss.smpl, ctx, -1);
+    common_sampler_accept(ss.smpl, ss.id_last, true);
+
+    llama_batch_free(batch);
+
+    ss.prompt_tgt = std::move(inp);
+    ss.n_past     = (int) ss.prompt_tgt.size();
+
+    common_speculative_begin(ss.spec, 0, ss.prompt_tgt);
+
+    return true;
+}
